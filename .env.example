# ChildLanguageNet RAG — Environment Variables
# Copy this file to .env and fill in your values.

# ── Provider selection ─────────────────────────────────────────────────────
# Choose "ollama" (default, free, local) or "openai" (requires API key)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ── Ollama settings (default) ─────────────────────────────────────────────
# Install Ollama: https://ollama.com/download
# Then: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ── OpenAI settings (optional) ────────────────────────────────────────────
# Uncomment and set these if using LLM_PROVIDER=openai / EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: user agent for web requests
USER_AGENT=childlanguagenet-rag/0.2 (research)

# LLM tuning
# TEMPERATURE=0.2
# MAX_TOKENS=1024

# Embedding tuning
# EMBEDDING_BATCH_SIZE=64
# USE_LOCAL_EMBEDDINGS=false

# Chunking
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# Retrieval
# DEFAULT_TOP_K=8

# UI
# UI_TITLE=Child Language Research RAG
# MAX_SOURCES_DISPLAY=10

# Telemetry
# LOG_LEVEL=INFO
# METRICS_ENABLED=true
