pipeline {
  agent any

  environment {
    AWS_REGION = credentials('AWS_REGION')              
    ECR_REPOSITORY = credentials('ECR_REPOSITORY')  
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')

    
    APP_HOST = credentials('APP_HOST')
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Continuous Integration (basic)') {
      steps {
        sh '''
          echo "Repository contents:"
          ls -la
          echo "--- Lint check ---"
          pip install ruff || true
          ruff check src/ tests/ || echo "Lint warnings found"
          echo "--- Tests ---"
          pip install pytest || true
          pytest tests/ -v || echo "Tests failed"
        '''
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws --version
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
        '''
      }
    }

    stage('Build Image') {
      steps {
        sh '''
          IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}"
          echo "Building image: ${IMAGE_URI}:${BUILD_NUMBER} and :latest"

          docker build -t ${IMAGE_URI}:${BUILD_NUMBER} -t ${IMAGE_URI}:latest .
        '''
      }
    }

    stage('Push Image') {
      steps {
        sh '''
          IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}"
          docker push ${IMAGE_URI}:${BUILD_NUMBER}
          docker push ${IMAGE_URI}:latest
        '''
      }
    }

    stage('Continuous Deployment (App EC2)') {
      steps {
       
        withCredentials([string(credentialsId: 'OPENAI_API_KEY', variable: 'OPENAI_API_KEY')]) {
          sshagent(['ssh_key']) {
            sh '''
              IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:latest"

              ssh -o StrictHostKeyChecking=no ubuntu@${APP_HOST} "
                set -e

                # Fetch the latest docker-compose.yml directly from GitHub
                curl -fsSL \
                  https://raw.githubusercontent.com/arunps12/ChildLanguageAcquisition-RAG/main/docker-compose.yml \
                  -o /home/ubuntu/docker-compose.yml

                # Login to ECR
                aws ecr get-login-password --region ${AWS_REGION} \
                  | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                # Export runtime variables for docker-compose
                export IMAGE_NAME=${IMAGE_URI}
                export OPENAI_API_KEY='${OPENAI_API_KEY}'

                cd /home/ubuntu
                docker compose pull
                docker compose up -d
                docker ps
              "
            '''
          }
        }
      }
    }
  }

  post {
    always {
      
      sh 'docker system prune -f || true'
    }
  }
}
